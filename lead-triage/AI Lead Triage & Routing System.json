        "responses": {
          "values": [
            {
              "content": "=You are a lead qualification assistant. Analyze the following lead message and return ONLY a valid JSON object — no explanations, no markdown formatting, no extra text.\n\nLead message: \"{{ $json.body.message }}\"\n\nReturn JSON in exactly this structure:\n{\n  \"sentiment\": \"Positive\" | \"Neutral\" | \"Negative\",\n  \"budget_mentioned\": true | false,\n  \"estimated_budget\": \"string describing budget if mentioned, else null\",\n  \"urgency\": \"High\" | \"Medium\" | \"Low\",\n  \"lead_score\": \"Hot\" | \"Warm\" | \"Cold\",\n  \"reasoning\": \"one short sentence explaining the score\"\n}\n\nScoring rules:\n- Hot: clear budget mentioned, positive sentiment, high urgency (wants to start soon)\n- Warm: some interest but missing budget OR urgency signals\n- Cold: vague inquiry, no budget, no urgency, or negative sentiment"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "store": false
        }
      },
