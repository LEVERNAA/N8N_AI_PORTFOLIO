    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output[0].content[0].text;\nconst parsed = JSON.parse(raw);\n\nreturn [\n  {\n    json: {\n      name: $('Webhook').first().json.body.name,\n      email: $('Webhook').first().json.body.email,\n      message: $('Webhook').first().json.body.message,\n      source: $('Webhook').first().json.body.source,\n      sentiment: parsed.sentiment,\n      budget_mentioned: parsed.budget_mentioned,\n      estimated_budget: parsed.estimated_budget,\n      urgency: parsed.urgency,\n      lead_score: parsed.lead_score,\n      reasoning: parsed.reasoning\n    }\n  }\n];"
      },
